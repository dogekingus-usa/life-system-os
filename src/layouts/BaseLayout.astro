---
export interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const siteTitle = 'LifeSystemOS — Life Operating System';
const fullTitle = title ? `${title} | ${siteTitle}` : siteTitle;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>

    <link rel="canonical" href={`https://lifesystemos.com${Astro.url.pathname}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image || 'https://lifesystemos.com/og-default.png'} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body class="bg-dark-800 text-gray-100 font-['Inter']">
    <header class="sticky top-0 z-50 border-b border-gray-700 bg-dark-800/95 backdrop-blur-sm">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href="/" class="text-xl font-bold text-brand-500">LifeSystemOS</a>
        <ul class="hidden md:flex gap-6 text-sm font-medium text-gray-300">
          <li><a href="/" class="hover:text-brand-500 transition">Home</a></li>
          <li><a href="/productivity/" class="hover:text-brand-500 transition">Productivity</a></li>
          <li><a href="/system/" class="hover:text-brand-500 transition">Systems</a></li>
          <li><a href="/habits/" class="hover:text-brand-500 transition">Habits</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-gray-700 bg-dark-800 py-8">
      <div class="mx-auto max-w-6xl px-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 text-sm text-gray-400">
          <div>
            <h3 class="text-brand-500 mb-3 font-semibold">LifeSystemOS</h3>
            <p>Build your life operating system — productivity, systems, habits, and mental clarity.</p>
          </div>
          <div>
            <h4 class="text-gray-200 mb-3 font-medium">Topics</h4>
            <ul class="space-y-2">
              <li><a href="/productivity/" class="hover:text-brand-500 transition">Productivity</a></li>
              <li><a href="/system/" class="hover:text-brand-500 transition">Systems</a></li>
              <li><a href="/habits/" class="hover:text-brand-500 transition">Habits</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-gray-200 mb-3 font-medium">Resources</h4>
            <ul class="space-y-2">
              <li><a href="/time/" class="hover:text-brand-500 transition">Time Management</a></li>
              <li><a href="/notion/" class="hover:text-brand-500 transition">Notion Guides</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-gray-200 mb-3 font-medium">Legal</h4>
            <ul class="space-y-2">
              <li><a href="/privacy/" class="hover:text-brand-500 transition">Privacy</a></li>
              <li><a href="/terms/" class="hover:text-brand-500 transition">Terms</a></li>
              <li><a href="/disclaimer/" class="hover:text-brand-500 transition">Disclaimer</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-8 border-t border-gray-700 pt-6 text-center text-xs text-gray-500">
          &copy; {new Date().getFullYear()} LifeSystemOS. All rights reserved.
        </div>
      </div>
    </footer>
  </body>
</html>
