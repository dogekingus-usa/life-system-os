---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/brain-food-productivity-diet-focus-energy-mental-clarity-2026.html?raw';

const title = "Brain Food 2026: The Ultimate Productivity Diet Guide — What to Eat for Focus, Energy \u0026 Mental Clarity | LifeSystemOS.com";
const description = "Discover the science-backed productivity diet for 2026. Learn which brain foods boost focus, memory, and mental energy — plus a complete 7-day meal plan for peak cognitive performance.";
const canonical = "https://lifesystemos.com/brain-food-productivity-diet-focus-energy-mental-clarity-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>