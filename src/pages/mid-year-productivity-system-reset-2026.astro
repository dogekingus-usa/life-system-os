---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/mid-year-productivity-system-reset-2026.html?raw';

const title = "Mid-Year Productivity Reset 2026: Reboot Your Life OS for Q3 \u0026 Beyond";
const description = "June is the perfect time to reboot your productivity system. Learn how to audit, declutter, and redesign your Life OS for a productive second half of 2026. Free templates included.";
const canonical = "https://lifesystemos.com/mid-year-productivity-system-reset-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>