---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Productivity';
---

<BaseLayout title="How to Design Your Digital Workspace for Maximum Focus and Flow" description="Your digital environment shapes your focus more than you realize. Learn how to design a distraction-free digital workspace that maximizes deep work...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">How to Design Your Digital Workspace for Maximum Focus and Flow</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">productivity</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Your digital environment shapes your focus more than you realize. Learn how to design a distraction-free digital workspace that maximizes deep work...</p>
    </div>
  </article>
</BaseLayout>
