---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Productivity';
---

<BaseLayout title="Life OS vs. Notion vs. Obsidian — Which Productivity System Wins in 2026?" description="We tested Life OS, Notion, and Obsidian head-to-head for 30 days. Here">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Life OS vs. Notion vs. Obsidian — Which Productivity System Wins in 2026?</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">productivity</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>We tested Life OS, Notion, and Obsidian head-to-head for 30 days. Here</p>
    </div>
  </article>
</BaseLayout>
