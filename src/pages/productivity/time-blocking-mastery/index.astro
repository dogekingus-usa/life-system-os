---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Productivity';
---

<BaseLayout title="Time Blocking Mastery: Own Your Calendar Like a CEO | Life System OS" description="Master time blocking to take control of your schedule. Learn how to structure your day, protect focus time, and eliminate task-switching forever.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Time Blocking Mastery: Own Your Calendar Like a CEO | Life System OS</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">productivity</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Master time blocking to take control of your schedule. Learn how to structure your day, protect focus time, and eliminate task-switching forever.</p>
    </div>
  </article>
</BaseLayout>
