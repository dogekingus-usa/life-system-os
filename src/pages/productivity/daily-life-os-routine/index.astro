---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Productivity';
---

<BaseLayout title="Daily Life OS: The Morning Productivity System That Runs Itself | LifeSystemOS" description="Build a morning productivity system that requires zero willpower. The Daily Life OS routine automates your best morning in 5 steps.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Daily Life OS: The Morning Productivity System That Runs Itself | LifeSystemOS</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">productivity</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Build a morning productivity system that requires zero willpower. The Daily Life OS routine automates your best morning in 5 steps.</p>
    </div>
  </article>
</BaseLayout>
