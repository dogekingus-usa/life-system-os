---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Productivity';
---

<BaseLayout title="How to Conduct a Personal Mid-Year Review: Realign Your Goals in Less Than 2 Hours" description="Don't wait until December to review your goals. Learn how to conduct a powerful mid-year review that realigns your focus and resets your trajectory...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">How to Conduct a Personal Mid-Year Review: Realign Your Goals in Less Than 2 Hours</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">productivity</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Don't wait until December to review your goals. Learn how to conduct a powerful mid-year review that realigns your focus and resets your trajectory...</p>
    </div>
  </article>
</BaseLayout>
