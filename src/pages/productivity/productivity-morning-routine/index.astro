---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Productivity';
---

<BaseLayout title="Perfect Productivity Morning Routine: Science-Backed" description="Perfect Productivity Morning Routine: Science-Backed body&#123;font-family:Segoe UI,sans-serif;max-width:800px;margin:0 auto;padding:20px;line-height:1.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Perfect Productivity Morning Routine: Science-Backed</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">productivity</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Perfect Productivity Morning Routine: Science-Backed body&#123;font-family:Segoe UI,sans-serif;max-width:800px;margin:0 auto;padding:20px;line-height:1.</p>
    </div>
