---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Productivity';
---

<BaseLayout title="The 12-Week Year: How to Achieve 12 Months of Results in 3 Months \u2014 Life System OS" description="Implementation guide for the 12 Week Year productivity system with weekly planning and accountability.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">The 12-Week Year: How to Achieve 12 Months of Results in 3 Months \u2014 Life System OS</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">productivity</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Implementation guide for the 12 Week Year productivity system with weekly planning and accountability.</p>
    </div>
  </article>
</BaseLayout>
