---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/10-books-that-will-completely-change-how-you-think-about-productivity.html?raw';

const title = "10 Books That Will Completely Change How You Think About Productivity | lifesystemos.com";
const description = "Boosting productivity can feel like an elusive goal, but with the right books by your side, you can transform your approach to work and life. Here are ten m";
const canonical = "https://lifesystemos.com/10-books-that-will-completely-change-how-you-think-about-productivity";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>