---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-5-am-club-is-waking-up-early-really-worth-it.html?raw';

const title = "The 5 AM Club: Is Waking Up Early Really Worth It — | lifesystemos.com";
const description = "The 5 AM Club: Is Waking Up Early Really Worth It? Introduction to the 5 AM Club Are you wondering";
const canonical = "https://lifesystemos.com/the-5-am-club-is-waking-up-early-really-worth-it";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>