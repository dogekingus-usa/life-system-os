---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/ultimate-morning-routine-high-achievers-science-backed-2026.html?raw';

const title = "The Ultimate Morning Routine for High Achievers: Science-Backed System for 2026 | LifeSystemOS.com";
const description = "Discover the science-backed morning routine used by high achievers in 2026. Learn the exact system to optimize your energy, focus, and productivity from the moment you wake up.";
const canonical = "https://lifesystemos.com/ultimate-morning-routine-high-achievers-science-backed-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>