---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/decision-fatigue-cure.html?raw';

const title = "The Decision Fatigue Cure: How to Save 10+ Hours of Mental Energy Per Week | Life System OS";
const description = "Learn the decision fatigue cure that saves 10+ hours of mental energy weekly. Reduce daily choices, automate decisions, and protect your willpower for what matters.";
const canonical = "https://lifesystemos.com/decision-fatigue-cure";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>