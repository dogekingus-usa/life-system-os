---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/ls-deep-work-environment-design-2026.html?raw';

const title = "Designing Your Deep Work Environment: How to Create a Physical and Digital Space That Makes Focus Automatic";
const description = "Design your physical and digital workspace for automatic deep focus. Covers lighting, ergonomics, digital blockers, Pavlovian triggers, soundscapes, and hygiene.";
const canonical = "https://lifesystemos.com/ls-deep-work-environment-design-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>