---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/productivity-frameworks-comparison.html?raw';

const title = "6 Productivity Frameworks That Work Together (Not Against Each Other) | LifeSystemOS.com | LifeSystemOS.com";
const description = "Build your complete productivity system by integrating OKRs, GTD, Time Blocking, Atomic Habits, and Deep Work.";
const canonical = "https://lifesystemos.com/productivity-frameworks-comparison";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>