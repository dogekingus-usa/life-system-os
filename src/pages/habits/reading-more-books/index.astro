---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Habits';
---

<BaseLayout title="Reading More Books: A System for Lifelong Learning | Life System OS" description="Want to read 52 books this year? Learn a practical system for reading more, retaining what you read, and building a lifelong learning habit.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Reading More Books: A System for Lifelong Learning | Life System OS</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">habits</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Want to read 52 books this year? Learn a practical system for reading more, retaining what you read, and building a lifelong learning habit.</p>
    </div>
  </article>
</BaseLayout>
