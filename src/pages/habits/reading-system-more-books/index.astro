---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Habits';
---

<BaseLayout title="Building a Reading System: How to Read More Books This Year \u2014 lifesystemos.com" description="Systematic approach to reading more books with retention techniques, tracking, and habit building.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Building a Reading System: How to Read More Books This Year \u2014 lifesystemos.com</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">habits</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Systematic approach to reading more books with retention techniques, tracking, and habit building.</p>
    </div>
  </article>
</BaseLayout>
