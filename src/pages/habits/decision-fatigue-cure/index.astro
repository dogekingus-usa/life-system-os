---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Habits';
---

<BaseLayout title="The Decision Fatigue Cure: How to Save 10+ Hours of Mental Energy Per Week | Life System OS" description="Learn the decision fatigue cure that saves 10+ hours of mental energy weekly. Reduce daily choices, automate decisions, and protect your willpower ...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">The Decision Fatigue Cure: How to Save 10+ Hours of Mental Energy Per Week | Life System OS</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">habits</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Learn the decision fatigue cure that saves 10+ hours of mental energy weekly. Reduce daily choices, automate decisions, and protect your willpower ...</p>
    </div>
  </article>
</BaseLayout>
