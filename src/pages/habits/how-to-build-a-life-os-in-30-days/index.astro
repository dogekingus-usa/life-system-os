---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Habits';
---

<BaseLayout title="How to Build a Life OS in 30 Days: A Day-by-Day Blueprint \u2014 lifesystemos.com" description="Build your personal Life OS in just 30 days with this comprehensive day-by-day blueprint covering systems, habits, tools, and routines.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">How to Build a Life OS in 30 Days: A Day-by-Day Blueprint \u2014 lifesystemos.com</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">habits</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Build your personal Life OS in just 30 days with this comprehensive day-by-day blueprint covering systems, habits, tools, and routines.</p>
    </div>
  </article>
</BaseLayout>
