---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-power-of-the-90-minute-work-block-science-backed-focus.html?raw';

const title = "The Power of the 90 Minute Work Block Science Backed Focus | lifesystemos.com";
const description = "Are you tired of feeling like your productivity is slipping through your fingers? The 90-minute work block, a scientifically-backed technique that aligns with";
const canonical = "https://lifesystemos.com/the-power-of-the-90-minute-work-block-science-backed-focus";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>