---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-ultimate-guide-to-habit-stacking-for-lasting-behavior-change.html?raw';

const title = "The Ultimate Guide to Habit Stacking for Lasting Behavior Change | LifeSystemOS.com";
const description = "Master habit stacking for lasting behavior change. Learn how to attach new habits to existing routines, build momentum, and transform your daily life.";
const canonical = "https://lifesystemos.com/the-ultimate-guide-to-habit-stacking-for-lasting-behavior-change";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>