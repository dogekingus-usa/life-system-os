---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/triage-productivity-method.html?raw';

const title = "The Triage Productivity Method: How to Stop Doing Low-Impact Work Forever | Life System OS";
const description = "Stop wasting time on low-impact work. The Triage Productivity Method teaches you how to categorize tasks like an emergency room doctor — urgent, important, or unnecessary — and eliminate 40% of your to-do list forever.";
const canonical = "https://lifesystemos.com/triage-productivity-method";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>