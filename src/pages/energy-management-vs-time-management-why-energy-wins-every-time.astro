---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/energy-management-vs-time-management-why-energy-wins-every-time.html?raw';

const title = "Energy Management vs Time Management: Why Energy Wins Every Time | lifesystemos.com";
const description = "Energy Management vs Time Management: Why Energy Wins Every Time Efficiency is key in todays fast-paced world. Many individuals and organizations";
const canonical = "https://lifesystemos.com/energy-management-vs-time-management-why-energy-wins-every-time";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>