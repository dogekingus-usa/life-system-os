---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/products.html?raw';

const title = "Products — Life System OS";
const description = "Premium life system os resources, templates, and guides to level up your results.";
const canonical = "https://lifesystemos.com/products";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>