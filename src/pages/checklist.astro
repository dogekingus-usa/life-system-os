---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/checklist.html?raw';

const title = "The Ultimate Productivity System Checklist — lifesystemos.com";
const description = "Your step-by-step checklist to build a Life OS that actually works. Downloadable interactive checklist for lifesystemos.com.";
const canonical = "https://lifesystemos.com/checklist.html";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>