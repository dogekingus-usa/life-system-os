---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/anti-perfectionism-productivity-system.html?raw';

const title = "The Anti-Perfectionism Productivity System: How to Get More Done by Doing Less Perfectly | Life System OS";
const description = "Perfectionism is the #1 productivity killer. Learn how the Anti-Perfectionism Productivity System helps you ship faster, reduce stress, and achieve more by embracing \u0027good enough\u0027.";
const canonical = "https://lifesystemos.com/anti-perfectionism-productivity-system";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>