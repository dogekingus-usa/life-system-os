---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/time-audit-guide-reclaim-hours-2026.html?raw';

const title = "The Complete Guide to Time Auditing: How to Find and Reclaim 20 Wasted Hours Per Week in 2026";
const description = "Learn how to conduct a personal time audit, identify hidden time leaks, and reclaim up to 20 hours per week using proven tracking methods and the 80/20 principle.";
const canonical = "https://lifesystemos.com/time-audit-guide-reclaim-hours-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>