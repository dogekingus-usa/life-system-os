---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-art-of-strategic-laziness-work-smarter-not-harder.html?raw';

const title = "The Art of Strategic Laziness: Work Smarter, Not Harder | lifesystemos.com";
const description = "The Art of Strategic Laziness: Work Smarter, Not Harder Are you tired of constantly pushing yourself to the brink in your quest for productivity? Welcom";
const canonical = "https://lifesystemos.com/the-art-of-strategic-laziness-work-smarter-not-harder";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>