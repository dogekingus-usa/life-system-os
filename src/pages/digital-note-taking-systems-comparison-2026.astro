---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/digital-note-taking-systems-comparison-2026.html?raw';

const title = "The Complete Guide to Digital Note-Taking Systems in 2026: Obsidian, Notion, Roam, Capacities, and Reflect Compared";
const description = "Compare the top 5 digital note-taking systems of 2026 — Obsidian, Notion, Roam Research, Capacities, and Reflect. Find the perfect second brain tool for your workflow.";
const canonical = "https://lifesystemos.com/digital-note-taking-systems-comparison-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>