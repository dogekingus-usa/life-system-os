---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-complete-guide-to-building-a-second-brain-using-notion.html?raw';

const title = "The Complete Guide to Building a Second Brain Using Notion | lifesystemos.com";
const description = "Welcome to your comprehensive guide on building a second brain using Notion! A second brain is an efficient way to organize, curate, and access information in";
const canonical = "https://lifesystemos.com/the-complete-guide-to-building-a-second-brain-using-notion";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>