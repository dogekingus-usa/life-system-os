---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-art-of-single-tasking-reclaim-focus-in-a-distracted-world.html?raw';

const title = "The Art of Single Tasking Reclaim Focus in a Distracted World | lifesystemos.com";
const description = "In todays fast-paced world, multitasking is often seen as a virtuesomething that helps us manage our time more efficiently. However, in reality, it can be de";
const canonical = "https://lifesystemos.com/the-art-of-single-tasking-reclaim-focus-in-a-distracted-world";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>