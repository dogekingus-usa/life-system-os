---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-life-os-saved-me-10-hours-a-week.html?raw';

const title = "How a Life OS Saved Me 10 Hours a Week: A Real User\u0027s Story  Life System OS";
const description = "How a Life OS Saved Me 10 Hours a Week: A Real User\u0027s Story  Life System OS";
const canonical = "https://lifesystemos.com/how-life-os-saved-me-10-hours-a-week";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>