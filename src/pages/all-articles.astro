---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/all-articles.html?raw';

const title = "All Articles — Life System OS";
const description = "Browse all 342 articles on Life System OS";
const canonical = "https://lifesystemos.com/all-articles";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>