---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-build-discipline-without-motivation-the-systems-approach.html?raw';

const title = "How to Build Discipline Without Motivation The Systems Approach | lifesystemos.com";
const description = "Building discipline without motivation can be challenging but is entirely achievable with the right systems approach. This article will guide you through creat";
const canonical = "https://lifesystemos.com/how-to-build-discipline-without-motivation-the-systems-approach";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>