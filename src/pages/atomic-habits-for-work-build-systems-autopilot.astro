---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/atomic-habits-for-work-build-systems-autopilot.html?raw';

const title = "Atomic Habits for Work: How to Build Systems That Run on Autopilot | LifeSystemOS.com";
const description = "Apply James Clear\u0027s Atomic Habits framework to your work life. Learn to build workplace systems that make productivity automatic  without relying on willpower.";
const canonical = "https://lifesystemos.com/atomic-habits-for-work-build-systems-autopilot";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>