---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/personal-sops-efficiency.html?raw';

const title = "Personal SOPs for Efficiency: Build Your Life Operating System";
const description = "Personal SOPs eliminate decision fatigue, cut task time by 40%, and turn chaos into routine. Complete guide with 4 templates and a fillable SOP worksheet.";
const canonical = "https://lifesystemos.com/personal-sops-efficiency";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>