---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-conduct-a-weekly-review-that-transforms-your-productivity.html?raw';

const title = "How to Conduct a Weekly Review That Transforms Your Productivity | lifesystemos.com";
const description = "Introduction: The Power of Weekly Reviews Weekly reviews are an essential tool for enhancing productivity and achieving your goals. By dedicating just one hour";
const canonical = "https://lifesystemos.com/how-to-conduct-a-weekly-review-that-transforms-your-productivity";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>