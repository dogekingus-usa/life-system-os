---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/checkout.html?raw';

const title = "Checkout — Life System OS";
const description = "Complete your purchase of premium digital products from Life System OS.";
const canonical = "https://lifesystemos.com/checkout.html";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>