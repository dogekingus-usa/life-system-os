---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-complete-guide-to-waking-up-early-without-feeling-miserable.html?raw';

const title = "The Complete Guide to Waking Up Early Without Feeling Miserable | lifesystemos.com";
const description = "Waking up early is often seen as a daunting task, especially when you\u0027re used to hitting snooze repeatedly or staying up late into the night. However, maki";
const canonical = "https://lifesystemos.com/the-complete-guide-to-waking-up-early-without-feeling-miserable";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>