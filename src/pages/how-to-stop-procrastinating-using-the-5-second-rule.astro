---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-stop-procrastinating-using-the-5-second-rule.html?raw';

const title = "How to Stop Procrastinating Using the 5-Second Rule | LifeSystemOS.com";
const description = "Learn how to stop procrastinating using the 5-Second Rule. Mel Robbins\u0027 proven method to overcome hesitation, take action, and build momentum instantly.";
const canonical = "https://lifesystemos.com/how-to-stop-procrastinating-using-the-5-second-rule";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>