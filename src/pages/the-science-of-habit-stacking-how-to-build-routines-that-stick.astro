---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-science-of-habit-stacking-how-to-build-routines-that-stick.html?raw';

const title = "The Science of Habit Stacking How to Build Routines That Stick | lifesystemos.com";
const description = "Habits are powerful tools that can transform your daily life. Whether you\u0027re looking to improve your health, boost productivity, or simply adopt a more fulfil";
const canonical = "https://lifesystemos.com/the-science-of-habit-stacking-how-to-build-routines-that-stick";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>