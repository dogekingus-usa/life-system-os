---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-create-a-personal-knowledge-management-system-from-scratch.html?raw';

const title = "How to Create a Personal Knowledge Management System from Scratch | lifesystemos.com";
const description = "In today\u0027s digital age, accumulating knowledge is easier than ever. However, managing that information efficiently can be a daunting task. Creating a perso";
const canonical = "https://lifesystemos.com/how-to-create-a-personal-knowledge-management-system-from-scratch";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>