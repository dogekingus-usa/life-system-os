---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/goal-setting-for-2026-beyond-smart-goals-to-okrs-and-bhags.html?raw';

const title = "Goal Setting for 2026: Beyond SMART Goals to OKRs and BHAGs | lifesystemos.com";
const description = "Goal Setting for 2026: Beyond SMART Goals to OKRs and BHAGs Welcome to our guide on how you can set ambitious yet achievable goals for 2026. As we ste";
const canonical = "https://lifesystemos.com/goal-setting-for-2026-beyond-smart-goals-to-okrs-and-bhags";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>