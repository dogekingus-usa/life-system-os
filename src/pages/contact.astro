---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/contact.html?raw';

const title = "Contact Us — Life System OS";
const description = "Get in touch with Life System OS. We\u0027d love to hear from you.";
const canonical = "https://lifesystemos.com/contact";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>