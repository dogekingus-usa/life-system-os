---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/todoist-vs-notion-2026-productivity-comparison.html?raw';

const title = "Todoist vs Notion 2026: Which Productivity Tool Should You Use?";
const description = "In-depth 2026 comparison of Todoist vs Notion for task management and productivity. See which tool wins for your workflow — plus a smarter alternative.";
const canonical = "https://lifesystemos.com/todoist-vs-notion-2026-productivity-comparison";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>