---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/index.html?raw';

const title = "Life System OS — Build Your Personal Operating System";
const description = "Build Your Personal Operating System — curated guides, tools, and systems to help you level up.";
const canonical = "https://lifesystemos.com";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>