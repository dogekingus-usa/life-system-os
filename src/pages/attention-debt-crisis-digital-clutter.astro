---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/attention-debt-crisis-digital-clutter.html?raw';

const title = "The Attention Debt Crisis: How Digital Clutter Is Stealing Your Focus (and How to Get It Back) | Life System OS";
const description = "Learn what attention debt is and how digital clutter silently steals your focus every day. Discover a step-by-step system to reclaim your attention, rebuild concentration, and take back control of your mind.";
const canonical = "https://lifesystemos.com/attention-debt-crisis-digital-clutter";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>