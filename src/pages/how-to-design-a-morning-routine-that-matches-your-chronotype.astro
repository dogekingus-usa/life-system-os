---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-design-a-morning-routine-that-matches-your-chronotype.html?raw';

const title = "How to Design a Morning Routine That Matches Your Chronotype | lifesystemos.com";
const description = "To design an effective morning routine that aligns perfectly with your chronotype, you first need to understand what a chronotype is and how it influences your";
const canonical = "https://lifesystemos.com/how-to-design-a-morning-routine-that-matches-your-chronotype";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>