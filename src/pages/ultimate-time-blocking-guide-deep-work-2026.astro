---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/ultimate-time-blocking-guide-deep-work-2026.html?raw';

const title = "Ultimate Time Blocking Guide for Deep Work 2026 | LifeSystemOS";
const description = "Master the art of time blocking for deep work. Learn how to structure your day for maximum focus, minimum context switching, and peak productivity in 2026.";
const canonical = "https://lifesystemos.com/ultimate-time-blocking-guide-deep-work-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>