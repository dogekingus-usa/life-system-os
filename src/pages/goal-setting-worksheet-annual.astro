---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/goal-setting-worksheet-annual.html?raw';

const title = "Annual Goal Planning Worksheet: Life Audit, Vision \u0026 Printable Template";
const description = "Annual goal planning worksheet with life areas assessment across 8 categories, yearly vision, quarterly milestones, monthly actions, weekly tasks, and printable review cadence tracker.";
const canonical = "https://lifesystemos.com/goal-setting-worksheet-annual";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'LifeSystemOS' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>