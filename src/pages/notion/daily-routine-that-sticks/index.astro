---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Notion';
---

<BaseLayout title="Daily Routine That Sticks: Habit Science, 3 Sample Routines & Builder Template" description="Daily routine that sticks using habit formation science from James Clear's 4 laws. Includes 3 sample daily routines, habit stacking guide, tracking...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Daily Routine That Sticks: Habit Science, 3 Sample Routines & Builder Template</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">notion</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Daily routine that sticks using habit formation science from James Clear's 4 laws. Includes 3 sample daily routines, habit stacking guide, tracking...</p>
    </div>
  </article>
</BaseLayout>
