---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Notion';
---

<BaseLayout title="Annual Goal Planning Worksheet: Life Audit, Vision & Printable Template" description="Annual goal planning worksheet with life areas assessment across 8 categories, yearly vision, quarterly milestones, monthly actions, weekly tasks, ...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Annual Goal Planning Worksheet: Life Audit, Vision & Printable Template</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">notion</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Annual goal planning worksheet with life areas assessment across 8 categories, yearly vision, quarterly milestones, monthly actions, weekly tasks, ...</p>
    </div>
  </article>
</BaseLayout>
