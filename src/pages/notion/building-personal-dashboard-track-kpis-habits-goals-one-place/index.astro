---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Notion';
---

<BaseLayout title="Building a Personal Dashboard: Track Your KPIs, Habits, and Goals in One Place" description="Learn how to build a personal dashboard that tracks your key performance indicators, habits, and goals in one place. Free templates and step-by-ste...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Building a Personal Dashboard: Track Your KPIs, Habits, and Goals in One Place</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">notion</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Learn how to build a personal dashboard that tracks your key performance indicators, habits, and goals in one place. Free templates and step-by-ste...</p>
    </div>
  </article>
</BaseLayout>
